{
  "name": "steam-pc-local-image-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Steam 本地图片浏览器 — 浏览、收藏、拼图 Steam 游戏图片",
  "author": "linmingqi",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 54088 --strictPort",
    "build:web": "vue-tsc --noEmit && vite build",
    "build": "tauri build --bundles nsis",
    "dist": "npm run build",
    "release": "node scripts/release.cjs",
    "upload": "node scripts/upload.cjs",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "html-to-image": "^1.11.13",
    "vue": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "latest",
    "@unocss/preset-uno": "^66.7.4",
    "@vitejs/plugin-vue": "latest",
    "@vue/tsconfig": "latest",
    "typescript": "latest",
    "unocss": "^66.7.4",
    "vite": "latest",
    "vitest": "latest",
    "vue-tsc": "latest"
  }
}
